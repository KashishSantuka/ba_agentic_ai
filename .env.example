# Google OAuth (Gmail readonly) — from the OAuth client you create in Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Storage
DATABASE_URL=postgresql+psycopg://<your-mac-username>@localhost:5432/ba_agentic
TEST_DATABASE_URL=postgresql+psycopg://<your-mac-username>@localhost:5432/ba_agentic_test

# Gmail sync (used only on the very first run, before any bookmark exists)
GMAIL_SYNC_LOOKBACK_DAYS=30

LOG_LEVEL=INFO

# Where attachment bytes are written, and the largest file to store
ATTACHMENT_DIR=data/attachments
ATTACHMENT_MAX_BYTES=26214400

# Scope classification (AI #1) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# An exact model, never a floating alias: an alias repoints without notice and the audit
# log would then credit answers to a model that never ran.
GEMINI_MODEL=gemini-3.5-flash-lite
# How many documents one run classifies, and how much of each body the model sees
SCOPE_BATCH_SIZE=100
SCOPE_BODY_CHAR_LIMIT=1000
# How long a document may sit in `processing` before a run assumes its worker died.
# Must exceed the longest a batch could legitimately take.
SCOPE_STALE_AFTER_MINUTES=15
